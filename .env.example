# Neon: Dashboard → Connection details → copy the connection string (use the
# "pooled" URL for serverless / Vercel, and optionally set DIRECT_URL to the
# non-pooled URL for migrations — see https://neon.tech/docs/connect/connection-pooling )

DATABASE_URL="postgresql://USER:PASSWORD@EP-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: unpooled connection for `prisma migrate dev` (Neon documents this pattern)
# DIRECT_URL="postgresql://USER:PASSWORD@EP-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT session (httpOnly cookie). Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET="replace-with-at-least-32-characters-random-string"

# Optional: session lifetime in seconds (default 604800 = 7 days)
# JWT_EXPIRES_SEC=604800

# Cloudflare R2 (optional): public read URL base for gallery thumbnails / previews — no trailing slash
# R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"

# Meta Graph API (system user token)
META_SYSTEM_ACCESS_TOKEN="replace-with-meta-system-access-token"

# Meta OAuth (Facebook Login) — redirect URI must match Meta app settings exactly, e.g.
# https://robust-neon.vercel.app/api/auth/callback
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""
