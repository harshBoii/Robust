# Neon: Dashboard → Connection details → copy the connection string (use the
# "pooled" URL for serverless / Vercel, and optionally set DIRECT_URL to the
# non-pooled URL for migrations — see https://neon.tech/docs/connect/connection-pooling )

DATABASE_URL="postgresql://USER:PASSWORD@EP-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: unpooled connection for `prisma migrate dev` (Neon documents this pattern)
# DIRECT_URL="postgresql://USER:PASSWORD@EP-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: separate Neon branch/DB for Prisma shadow database (migrate dev / migrate diff).
# Use a disposable branch — do not point this at production if it is the same as DATABASE_URL.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@EP-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT session (httpOnly cookie). Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET="replace-with-at-least-32-characters-random-string"

# Optional: session lifetime in seconds (default 604800 = 7 days)
# JWT_EXPIRES_SEC=604800

# Cloudflare R2 (optional): public read URL base for gallery thumbnails / previews — no trailing slash
# R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"

# Meta Graph API (system user token)
META_SYSTEM_ACCESS_TOKEN="replace-with-meta-system-access-token"

# Meta OAuth (Facebook Login) — redirect URI must match Meta app settings exactly, e.g.
# https://robust-neon.vercel.app/api/auth/callback
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""

# Google Ads OAuth + API
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_REDIRECT_URI=""

# Shopify OAuth + Admin API
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products"
SHOPIFY_APP_URL="https://your-app.vercel.app"
# Optional: Partners install link (step 1)
# SHOPIFY_CONNECT_URL=""
# SHOPIFY_API_VERSION="2026-01"

# Company seed microservice (Data Mine auto-fill, POST /company/seed)
MICROSERVICE_URL="http://localhost:8000"

# Social OAuth (X, LinkedIn, Reddit) — redirect URI should be https://your-app/api/auth/social/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_REDIRECT_URI=""

# Asset Intelligence microservice (POST /process-from-api)
ASSET_INTELLIGENCE_MICROSERVICE_URL="http://localhost:8001"

# Optional: scene preset sent to /process-from-api (default: sensitive)
# INTEL_SCENE_PRESET="sensitive"

# Optional: webhook secret for POST /api/receive-intel (header: x-intel-secret)
# INTEL_WEBHOOK_SECRET=""

# Meta creative import/link logging ([meta-creative] request/response/progress). Default on in dev; set 1 to force, 0 to disable.
# META_CREATIVE_LOG=1

# Public app URL for microservice download callbacks (api_url in analyze payload)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# HeyGen Video Agent (POST /v3/video-agents)
HEYGEN_API_KEY=""

# Optional: webhook secret for POST /api/heygen/webhook (header: x-heygen-secret)
# HEYGEN_WEBHOOK_SECRET=""

# Elasticsearch (product search)
ELASTICSEARCH_URL=""
ELASTICSEARCH_API_KEY=""
PRODUCTS_INDEX="shopify_products"
