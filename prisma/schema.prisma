model PromptExecution {
  id         String     @id @default(cuid())
  promptId   String
  model      String     @db.VarChar(100)
  response   String
  executedAt DateTime   @default(now()) @db.Timestamptz(3)
  citations  Citation[]
  prompt     Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([model])
  @@index([executedAt])
  @@map("llm_prompt_executions")
}

model Prompt {
  id              String   @id @default(cuid())
  query           String
  topic           String?  @db.VarChar(255)
  topicId         String?
  reason          String?
  expectedRevenue Float?
  intent          String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  ishunted        Boolean  @default(false)

  aeo_pages       AeoPage[]

  executions       PromptExecution[]
  llmTopic         LlmTopic?              @relation("LlmTopicPrompts", fields: [topicId], references: [id])
  llmPromptMetrics LlmPromptMetric[]
  revenue          PromptRevenue?
  rivalByModel     PromptRivalByModel[]
  rivalConsensus   PromptRivalConsensus[]

  @@index([intent])
  @@index([topic])
  @@index([topicId])
  @@map("llm_prompts")
}

model PromptRevenue {
  id                 String   @id @default(cuid())
  promptId           String   @unique
  monthlyPromptReach Float?
  visibilityWeight   Float?
  ctr                Float?
  cvr                Float?
  aov                Float?
  estimatedRevenue   Float?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  prompt             Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([estimatedRevenue])
  @@map("llm_prompt_revenues")
}

model LlmTopic {
  id               String            @id @default(cuid())
  name             String            @db.VarChar(255)
  description      String?
  reason           String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  difficulty       Difficulty        @default(MEDIUM)
  companyId        String
  prompts          Prompt[]          @relation("LlmTopicPrompts")
  llmPromptMetrics LlmPromptMetric[]
  aeo_pages        AeoPage[]
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("llm_topics")
}

model PromptRivalByModel {
  id          String   @id @default(cuid())
  promptId    String
  model       String   @db.VarChar(100)
  companyName String   @db.VarChar(255)
  rank        Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  prompt      Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, model, companyName])
  @@index([promptId])
  @@index([model])
  @@map("llm_prompt_rivals_by_model")
}

model PromptRivalConsensus {
  id          String   @id @default(cuid())
  promptId    String
  companyName String   @db.VarChar(255)
  avgRank     Float?
  mentions    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  prompt      Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, companyName])
  @@index([promptId])
  @@map("llm_prompt_rivals_consensus")
}

model LlmRadarMetric {
  id             String   @id @default(cuid())
  companyId      String
  model          String   @db.VarChar(100)
  shareOfVoice   Float?
  top3Rate       Float?
  queryCoverage  Float?
  avgRank        Float?
  calculatedAt   DateTime @default(now()) @db.Timestamptz(3)
  competitorRank Float?
  topicAuthority Float?
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([model])
  @@index([companyId, calculatedAt(sort: Desc)])
  @@map("llm_radar_metrics")
}

model LlmPromptMetric {
  id               String      @id @default(cuid())
  companyId        String
  promptId         String
  topicId          String?
  model            String      @db.VarChar(100)
  latestRank       Int?
  isMentioned      Boolean     @default(false)
  estimatedReach   Int?
  confidence       Float?
  difficulty       Difficulty?
  businessFit      Float?
  opportunityScore Float?
  estimatedRevenue Float?
  actionType       String?     @db.VarChar(32)
  rankTrend7d      Float?
  rankTrend30d     Float?
  modelGapFlag     Boolean     @default(false)
  calculatedAt     DateTime    @default(now()) @db.Timestamptz(3)
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prompt           Prompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  llmTopic         LlmTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([companyId, promptId, model])
  @@index([companyId])
  @@index([promptId])
  @@index([calculatedAt(sort: Desc)])
  @@map("llm_prompt_metrics")
}

/// Company-level CTR/CVR assumptions for prompt revenue estimates (edit UI later)
model RadarAssumption {
  id             String   @id @default(cuid())
  companyId      String   @unique
  /// Click-through from impression to site (ratio 0–1)
  ctr            Float    @default(0.02)
  /// Conversion to order (ratio 0–1), aligned with D2C defaults when unset on bounties
  cvr            Float    @default(0.025)
  aovMultiplier  Float    @default(1)
  industryPreset String?  @db.VarChar(50)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("radar_assumptions")
}

model CitationBounty {
  id                String           @id @default(cuid())
  companyId         String
  query             String
  intent            String?          @db.VarChar(255)
  pageType          AeoPageType
  confidence        Float
  difficulty        BountyDifficulty @default(EASY)
  estimatedReach    Int?
  /// estimatedReach × (conversionRate ?? default) × (avgOrderValue ?? company AOV)
  estimatedRevenue  Float?
  /// Site / funnel conversion (e.g. 0.025); defaults applied in app when null
  conversionRate    Float?
  /// Snapshot AOV used for revenue estimate (often from Shopify catalog median)
  avgOrderValue     Float?
  suggestedCluster  String?          @db.VarChar(255)
  status            BountyStatus     @default(OPEN)
  huntedAt          DateTime?        @db.Timestamptz(3)
  /// When generated content was published (e.g. AEO page go-live)
  publishedAt       DateTime?        @db.Timestamptz(3)
  aeoPageId         String?          @unique
  /// Snapshot of platforms selected at get-cited time, e.g. ["WEBSITE_BLOG","X"]
  spreadPlatforms   Json?
  generationContext Json             @default("{}")
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  aeoPage           AeoPage?         @relation(fields: [aeoPageId], references: [id])
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contents          BountyContent[]

  @@index([companyId])
  @@index([status])
  @@index([confidence])
  @@index([difficulty])
  @@index([companyId, status])
  @@index([companyId, status, confidence])
  @@map("citation_bounties")
}

model BountyContent {
  id                String               @id @default(cuid())
  companyId         String
  bountyId          String
  platform          BountySpreadPlatform
  status            BountyContentStatus  @default(DRAFT)
  title             String?              @db.VarChar(500)
  body              String               @db.Text
  metadata          Json?
  publishedUrl      String?              @db.VarChar(1000)
  externalPostId    String?              @db.VarChar(255)
  approvedAt        DateTime?            @db.Timestamptz(3)
  publishedAt       DateTime?            @db.Timestamptz(3)
  errorMessage      String?              @db.Text
  generationContext Json?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  bounty            CitationBounty       @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([bountyId, platform])
  @@index([companyId])
  @@index([bountyId])
  @@index([platform])
  @@index([status])
  @@map("bounty_contents")
}

model SocialIntegration {
  id              String         @id @default(cuid())
  companyId       String
  provider        SocialProvider
  accessToken     String?        @db.Text
  refreshToken    String?        @db.Text
  zernioAccountId String?        @unique @db.VarChar(255)
  accountHandle   String?        @db.VarChar(255)
  expiresAt       DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("social_integrations")
}

model ZernioProfile {
  id              String   @id @default(cuid())
  companyId       String   @unique
  zernioProfileId String   @unique @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("zernio_profiles")
}


