// ================================================================
// PUBLISH JOBS (META)
// ================================================================

model AdPublishJob {
  id                 String           @id @default(cuid())
  companyId          String
  metaIntegrationId  String
  campaignId         String
  adSetId            String
  assetId            String
  adPresetId         String?
  scheduleId         String?
  status             PublishJobStatus @default(QUEUED)
  attempts           Int              @default(0)
  maxAttempts        Int              @default(3)
  scheduledAt        DateTime?        @db.Timestamptz(3)
  startedAt          DateTime?        @db.Timestamptz(3)
  completedAt        DateTime?        @db.Timestamptz(3)
  lastError          String?          @db.Text
  metaCreativeDbId   String?
  metaAdDbId         String?
  duplicatedFromAdId String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  headlineOverride    String? @db.VarChar(500)
  primaryTextOverride String? @db.Text
  descriptionOverride String? @db.Text
  landingUrlOverride  String? @db.VarChar(2000)
  ctaTypeOverride     String? @db.VarChar(100)
  pixelIdOverride     String? @db.VarChar(100)
  groupKey            String? @db.VarChar(120)

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet    MetaAdSet   @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  asset    Asset       @relation(fields: [assetId], references: [id])
  adPreset AdPreset?   @relation(fields: [adPresetId], references: [id], onDelete: SetNull)
