model MetaMedia {
  id                String   @id @default(cuid())
  metaIntegrationId String
  /// "image" | "video"
  kind              String   @db.VarChar(10)
  imageHash         String?  @db.VarChar(200)
  videoId           String?  @db.VarChar(100)
  /// Ad account (`act_…`) this media was uploaded to on Meta; used to avoid cross-account reuse.
  uploadedAdAccountId String? @db.VarChar(50)
  assetId           String?  @unique
  imageUrl          String?  @db.VarChar(1000)
  videoUrl          String?  @db.VarChar(1000)
  videoStreamId     String?  @db.VarChar(100)
  thumbnailUrl      String?  @db.VarChar(1000)
  r2Key             String?  @db.VarChar(500)
  filename          String?  @db.VarChar(500)
  mimeType          String?  @db.VarChar(200)
  bytes             Int?
  width             Int?
  height            Int?
  durationMs        Int?
  /// uploading | processing | ready | error
  status            String   @default("ready") @db.VarChar(20)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([metaIntegrationId, imageHash])
  @@unique([metaIntegrationId, videoId])
  @@index([metaIntegrationId])
  @@index([imageHash])
  @@index([videoId])
  @@map("meta_media")
}

model MetaCampaign {
  id                  String    @id @default(cuid())
  metaIntegrationId   String
  metaCampaignId      String    @db.VarChar(100)
  campaignPresetId    String?
  name                String    @db.VarChar(500)
  /// OUTCOME_TRAFFIC, OUTCOME_SALES, OUTCOME_LEADS etc.
  objective           String    @db.VarChar(100)
  /// ACTIVE | PAUSED | ARCHIVED
  status              String    @db.VarChar(50)
  /// In smallest currency unit; 0 when budget lives on ad set
  dailyBudget         Int       @default(0)
  lifetimeBudget      Int?
  spendCap            BigInt?
  specialAdCategory   String?   @db.VarChar(100)
  specialAdCategories Json?     @default("[]")
  bidStrategy         String?   @db.VarChar(64)
  publishedAt         DateTime? @db.Timestamptz(3)
  reviewStatus        String?   @db.VarChar(50)
  reviewFeedback      String?   @db.Text
