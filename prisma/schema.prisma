// ================================================================
// COMPANY BACKGROUND JOBS (Upstash QStash)
// ================================================================

model CompanyJobConfig {
  id               String         @id @default(cuid())
  companyId        String         @map("company_id")
  jobType          CompanyJobType @map("job_type")
  enabled          Boolean        @default(false)
  frequency        JobFrequency   @default(WEEKLY)
  schedule         Json           @default("{\"hour\":14,\"minute\":30,\"dayOfWeek\":1,\"dayOfMonth\":1,\"timezone\":\"Asia/Kolkata\"}")
  settings         Json           @default("{}")
  qstashScheduleId String?        @map("qstash_schedule_id") @db.VarChar(255)
  lastRunAt        DateTime?      @map("last_run_at") @db.Timestamptz(3)
  nextRunAt        DateTime?      @map("next_run_at") @db.Timestamptz(3)
