  @@index([companyId, status])
  @@index([scheduledAt, status])
  @@index([scheduleId])
  @@index([metaIntegrationId])
  @@index([campaignId])
  @@index([adSetId])
  @@index([assetId])
  @@index([adPresetId])
  @@index([metaAdDbId])
  @@map("ad_publish_jobs")
}

// ================================================================
// HEYGEN VIDEO GENERATION
// ================================================================

model VideoGenerationJob {
  id              String            @id @default(cuid())
  companyId       String
  script          String            @db.Text
  avatarId        String            @default("auto") @db.VarChar(64)
  voiceId         String            @default("auto") @db.VarChar(64)
  heygenStatus    VideoGenJobStatus @default(PENDING)
