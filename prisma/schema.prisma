}

/// One rule per type per company — toggled on/off via UI
model AdAutomationRule {
  id               String    @id @default(cuid())
  companyId        String
  ruleType         RuleType
  isEnabled        Boolean   @default(true)
  /// Numeric trigger threshold (e.g. CPI ceiling, CTR drop %)
  threshold        Float?
  /// Lookback / evaluation window in days
  window           Int?
  lastTriggeredAt  DateTime? @db.Timestamptz(3)
  requiresApproval Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  AdAutomationEvent[]

  @@unique([companyId, ruleType])
  @@index([companyId])
  @@map("ad_automation_rules")
}

/// Audit log of every rule-triggered action
model AdAutomationEvent {
  id          String         @id @default(cuid())
  companyId   String
  ruleId      String
  /// Meta ad id
  adId        String         @db.VarChar(100)
  actionTaken AutoActionType
  details     Json           @default("{}")
  /// null = pending approval | true = approved | false = rejected
  approved    Boolean?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule          AdAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([companyId])
  @@index([ruleId])
  @@index([adId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("ad_automation_events")
}

/// UI notification bell — one row per user-facing alert
model Notification {
  id        String    @id @default(cuid())
  companyId String
  /// FK to AdAutomationEvent — nullable for manual/system notifications
  eventId   String?
  /// AUTO_PAUSE | FATIGUE_ALERT | BUDGET_PACING | SPEND_CONCENTRATION | WINNER_AMPLIFICATION
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event   AdAutomationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

