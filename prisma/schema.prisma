  allowStaticGeneration Boolean  @default(true) @map("allow_static_generation")
  /// auto_generate | manual_selection
  mediaMode             String   @default("auto_generate") @map("media_mode") @db.VarChar(32)
  defaultArtistId       String?  @map("default_artist_id") @db.VarChar(32)
  autoPost              Boolean  @default(false) @map("auto_post")
  defaultDailyBudget    Int?     @map("default_daily_budget")
  defaultObjective      String?  @map("default_objective") @db.VarChar(64)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

