// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================================================
// CORE TENANT
// ================================================================

model Company {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String?
  logoUrl     String? @db.VarChar(1000)
  website     String? @db.VarChar(500)
  linkedinUrl String? @map("linkedin_url") @db.VarChar(1000)
  domain      String? @db.VarChar(255)
  email       String? @unique @db.VarChar(255)
  userName    String? @unique @db.VarChar(255)
  password    String? @db.VarChar(255)

  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret") @db.Text

  // Subscription
  subscriptionId        String?            @map("subscription_id")
  subscriptionStatus    SubscriptionStatus @default(PENDING) @map("subscription_status")
  subscriptionCreatedAt DateTime?          @map("subscription_created_at")
  subscriptionUpdatedAt DateTime?          @map("subscription_updated_at")

  // Onboarding / access request
  accessStatus      AccessStatus @default(APPROVED) @map("access_status")
  accessRequestedAt DateTime?    @map("access_requested_at") @db.Timestamptz(3)
  accessReviewedAt  DateTime?    @map("access_reviewed_at") @db.Timestamptz(3)
  accessReviewNote  String?      @map("access_review_note") @db.Text
  onboardingPlan    Json?        @map("onboarding_plan")
  onboardingStep    String?      @map("onboarding_step") @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  metaIntegration         MetaIntegration?
  googleAdsIntegration    GoogleAdsIntegration?
  integrationCms          CompanyIntegrationCms[]
  shopifyShops       ShopifyShop[]
  shopifyProducts    ShopifyProduct[]
  assets             Asset[]
  bulkUploads        BulkUpload[]
  assetBuckets       AssetBucket[]
  adPresets          AdPreset[]
  adsetPresets       AdsetPreset[]
  campaignPresets    CampaignPreset[]
  adSchedules        AdSchedule[]
  adAutomationRules  AdAutomationRule[]
  adAutomationEvents AdAutomationEvent[]
  notifications      Notification[]
  adPublishJobs      AdPublishJob[]
  googleAdsPublishJobs GoogleAdPublishJob[]
  assistantCreativeUsage AssistantCreativeUsage[]
  adChatSessions     AdChatSession[]
  authSessions       AuthSession[]
  loginActivities    LoginActivity[]
  brandEntity        BrandEntity?
  offerings          Offering[]
  assetIntelligences AssetIntelligence[]
  videoGenerationJobs VideoGenerationJob[]
  aeoGenerationProfiles   AeoGenerationProfile[]
  aeoPages                AeoPage[]
  citationBounties        CitationBounty[]
  bountyContents          BountyContent[]
  socialIntegrations      SocialIntegration[]
  zernioProfile           ZernioProfile?
  contentClusters         ContentCluster[]
  geoDataSources          GeoDataSource[]
  Citations               Citation[]
  LlmRadarMetrics         LlmRadarMetric[]
  llmTopics               LlmTopic[]
  radarAssumption         RadarAssumption?
  llmPromptMetrics        LlmPromptMetric[]
  rivals                  CompanyRival[] @relation("CompanyRivals")
  rivalOf                 CompanyRival[] @relation("CompanyRivalTargets")
  shopifyBlogChannels     ShopifyBlogChannel[]
  metaAdsAutoConfig       MetaAdsAutoConfig?
  metaApiLogs             MetaApiLog[]
  companyJobConfigs       CompanyJobConfig[]
  lastMicroserviceJobAt   DateTime? @map("last_microservice_job_at") @db.Timestamptz(3)
  customProducts          CustomProduct[]

  @@index([slug])
  @@map("companies")
}

// ================================================================
// DATA MINE (company seed / brand enrichment)
// ================================================================

model BrandEntity {
  id                  String   @id @default(cuid())
  companyId           String   @unique @map("company_id")
  canonicalName       String   @map("canonical_name") @db.VarChar(255)
  aliases             String[] @default([])
  entityType          String?  @map("entity_type") @db.VarChar(64)
  oneLiner            String?  @map("one_liner") @db.Text
  about               String?  @db.Text
  industry            String?  @db.VarChar(255)
  category            String?  @db.VarChar(255)
  headquartersCity    String?  @map("headquarters_city") @db.VarChar(255)
  headquartersCountry String?  @map("headquarters_country") @db.VarChar(255)
  foundedYear         Int?     @map("founded_year")
  employeeRange       String?  @map("employee_range") @db.VarChar(64)
  businessModel       String?  @map("business_model") @db.VarChar(64)
  topics              String[] @default([])
  keywords            String[] @default([])
  targetAudiences     String[] @default([]) @map("target_audiences")
  branding            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offerings             Offering[]
  aeoGenerationProfiles AeoGenerationProfile[]
  visualDna             VisualDna?
  communicationDna      CommunicationDna?
  audienceDna           AudienceDna?
  complianceDna         ComplianceDna?

  @@map("brand_entities")
}

model VisualDna {
  id                    String   @id @default(cuid())
  brandEntityId         String   @unique @map("brand_entity_id")
  visualStyle           String?  @map("visual_style") @db.VarChar(128)
  visualMaturity        String?  @map("visual_maturity") @db.VarChar(128)
  designComplexity      String?  @map("design_complexity") @db.VarChar(64)
  primaryColor          String?  @map("primary_color") @db.VarChar(32)
  secondaryColor        String?  @map("secondary_color") @db.VarChar(32)
  accentColor           String?  @map("accent_color") @db.VarChar(32)
  backgroundColor       String?  @map("background_color") @db.VarChar(32)
  headingFont           String?  @map("heading_font") @db.VarChar(255)
  bodyFont              String?  @map("body_font") @db.VarChar(255)
  typographyPersonality String?  @map("typography_personality") @db.VarChar(128)
  whitespaceLevel       String?  @map("whitespace_level") @db.VarChar(64)
  contentDensity        String?  @map("content_density") @db.VarChar(64)
  alignmentStyle        String?  @map("alignment_style") @db.VarChar(128)
  cornerRadiusStyle     String?  @map("corner_radius_style") @db.VarChar(64)
  shadowStyle           String?  @map("shadow_style") @db.VarChar(64)
  preferredVisualMotif  String?  @map("preferred_visual_motif") @db.VarChar(128)
  visualEmotion         String?  @map("visual_emotion") @db.VarChar(128)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)

  @@map("visual_dna")
}

model CommunicationDna {
  id                        String   @id @default(cuid())
  brandEntityId             String   @unique @map("brand_entity_id")
  tone                      String?  @db.VarChar(128)
  voice                     String?  @db.VarChar(128)
  brandPersonality          String?  @map("brand_personality") @db.VarChar(128)
  emotionalIntensity        String?  @map("emotional_intensity") @db.VarChar(64)
  headlineStyle             String?  @map("headline_style") @db.VarChar(128)
  ctaStyle                  String?  @map("cta_style") @db.VarChar(128)
  urgencyLevel              String?  @map("urgency_level") @db.VarChar(64)
  socialProofUsage          String?  @map("social_proof_usage") @db.VarChar(64)
  primaryMessagingTheme     String?  @map("primary_messaging_theme") @db.Text
  secondaryMessagingTheme   String?  @map("secondary_messaging_theme") @db.Text
  avoidedMessagingTheme     String?  @map("avoided_messaging_theme") @db.Text
  readingLevel              String?  @map("reading_level") @db.VarChar(64)
  avgSentenceLength         Int?     @map("avg_sentence_length")
  paragraphDensity          String?  @map("paragraph_density") @db.VarChar(64)
  activeVoicePercentage     Int?     @map("active_voice_percentage")
  positioningStatement      String?  @map("positioning_statement") @db.Text
  valuePropositionStyle     String?  @map("value_proposition_style") @db.VarChar(128)
  differentiationStrategy   String?  @map("differentiation_strategy") @db.VarChar(128)
  introPattern              String?  @map("intro_pattern") @db.VarChar(128)
  storytellingPattern       String?  @map("storytelling_pattern") @db.VarChar(128)
  conclusionPattern         String?  @map("conclusion_pattern") @db.VarChar(128)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)

  @@map("communication_dna")
}

model AudienceDna {
  id                   String   @id @default(cuid())
  brandEntityId        String   @unique @map("brand_entity_id")
  primaryPersona       String?  @map("primary_persona") @db.VarChar(255)
  secondaryPersona     String?  @map("secondary_persona") @db.VarChar(255)
  industryFocus        String?  @map("industry_focus") @db.VarChar(255)
  technicalLevel       String?  @map("technical_level") @db.VarChar(64)
  domainKnowledgeLevel String?  @map("domain_knowledge_level") @db.VarChar(64)
  audiencePainPoints   String[] @default([]) @map("audience_pain_points")
  audienceMotivations  String[] @default([]) @map("audience_motivations")
  audienceObjections   String[] @default([]) @map("audience_objections")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)

  @@map("audience_dna")
}

model ComplianceDna {
  id                          String   @id @default(cuid())
  brandEntityId               String   @unique @map("brand_entity_id")
  bannedAbsoluteClaims        String[] @default([]) @map("banned_absolute_claims")
  bannedComparativeClaims     String[] @default([]) @map("banned_comparative_claims")
  allowedClaims               String[] @default([]) @map("allowed_claims")
  bannedWords                 String[] @default([]) @map("banned_words")
  allowedWords                String[] @default([]) @map("allowed_words")
  fearBasedMarketingAllowed   Boolean  @default(false) @map("fear_based_marketing_allowed")
  sensationalLanguageAllowed  Boolean  @default(false) @map("sensational_language_allowed")
  politicalContentAllowed     Boolean  @default(false) @map("political_content_allowed")
  religiousContentAllowed     Boolean  @default(false) @map("religious_content_allowed")
  controversialTopicsAllowed    Boolean  @default(false) @map("controversial_topics_allowed")
  sourceFileUrl               String?  @map("source_file_url") @db.VarChar(2000)
  sourceFileName              String?  @map("source_file_name") @db.VarChar(500)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)

  @@map("compliance_dna")
}

model Offering {
  id              String       @id @default(cuid())
  companyId       String       @map("company_id")
  brandEntityId   String       @map("brand_entity_id")
  name            String       @db.VarChar(500)
  slug            String       @db.VarChar(255)
  description     String?      @db.Text
  offeringType    OfferingType @default(PRODUCT) @map("offering_type")
  url             String?      @db.VarChar(1000)
  keywords        String[]     @default([])
  useCases        String[]     @default([]) @map("use_cases")
  targetAudiences String[]     @default([]) @map("target_audiences")
  differentiators String[]     @default([])
  competitors     String[]     @default([])
  isPrimary       Boolean      @default(false) @map("is_primary")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)

  @@unique([brandEntityId, slug])
  @@index([companyId])
  @@map("offerings")
}

model CustomProduct {
  id              String              @id @default(cuid())
  companyId       String              @map("company_id")
  name            String              @db.VarChar(500)
  description     String?             @db.Text
  category        String?             @db.VarChar(255)
  productType     CustomProductType   @default(SERVICE) @map("product_type")
  status          CustomProductStatus @default(DRAFT)

  // Content generation
  tagline         String?             @db.VarChar(500)
  keyBenefits     Json?               @default("[]") @map("key_benefits")
  targetAudience  String?             @map("target_audience") @db.Text
  keywords        Json?               @default("[]")
  toneNotes       String?             @map("tone_notes") @db.Text

  // Context
  mediaUrls       Json?               @default("[]") @map("media_urls")
  faqs            Json?               @default("[]")
  certifications  String?             @db.Text

  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@map("custom_products")
}

model AuthSession {
  id         String    @id @default(cuid())
  companyId  String
  userAgent  String?   @db.VarChar(500)
  ipAddress  String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginActivity {
  id        String   @id @default(cuid())
  companyId String?
  success   Boolean
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("login_activities")
}

// ================================================================
// AD CHAT (conversational ad posting)
// ================================================================

model AdChatSession {
  id              String              @id @default(cuid())
  companyId       String
  createdByUserId String?             @db.VarChar(255)
  title           String              @default("New chat") @db.VarChar(500)
  status          AdChatSessionStatus @default(ACTIVE)
  pathType        ChatPathType?
  currentStep     String              @default("intent") @db.VarChar(64)
  workflowState   Json                @default("{}")
  bulkUploadId    String?
  campaignId      String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages AdChatMessage[]

  @@index([companyId])
  @@index([companyId, updatedAt(sort: Desc)])
  @@map("ad_chat_sessions")
}

model AdChatMessage {
  id            String            @id @default(cuid())
  sessionId     String
  role          AdChatMessageRole
  content       String?
  widgetType    String?           @db.VarChar(64)
  widgetPayload Json?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  session AdChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("ad_chat_messages")
}

/// Per-company daily counter for vision creative-suggest API
model AssistantCreativeUsage {
  companyId String
  date      DateTime @db.Date
  count     Int      @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, date])
  @@map("assistant_creative_usage")
}

// ================================================================
// ASSETS & GALLERY
// ================================================================

model BulkUpload {
  id        String           @id @default(cuid())
  companyId String
  name      String           @db.VarChar(255)
  status    BulkUploadStatus @default(PROCESSING)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets       Asset[]
  assetBuckets AssetBucket[]

  @@index([companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("bulk_uploads")
}

model AssetBucket {
  id           String     @id @default(cuid())
  companyId    String
  bulkUploadId String
  label        String     @db.VarChar(255)
  bucketType   BucketType
  bucketValue  String     @db.VarChar(255)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bulkUpload BulkUpload @relation(fields: [bulkUploadId], references: [id], onDelete: Cascade)
  assets     Asset[]

  @@index([companyId])
  @@index([bulkUploadId])
  @@map("asset_buckets")
}

model Asset {
  id            String       @id @default(cuid())
  companyId     String
  bulkUploadId  String?
  assetBucketId String?
  assetType     AssetType
  title         String       @db.VarChar(500)
  filename      String       @db.VarChar(500)
  originalSize  BigInt
  status              AssetStatus         @default(UPLOADING)
  intelligenceStatus  IntelligenceStatus  @default(NONE)
  r2Key         String       @db.VarChar(500)
  r2Bucket      String       @db.VarChar(255)
  resolution    String?      @db.VarChar(20)
  mimeType      String?      @db.VarChar(100)
  duration      Int?
  fps           Int?
  codec         String?      @db.VarChar(50)
  streamId      String?      @unique @db.VarChar(255)
  playbackUrl   String?      @db.VarChar(2000)
  thumbnailUrl  String?      @db.VarChar(1000)
  tags          String[]     @default([])
  metadata      Json         @default("{}")
  uploadSource  UploadSource @default(NATIVE)
  videoHash     String?      @db.VarChar(300)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bulkUpload  BulkUpload?  @relation(fields: [bulkUploadId], references: [id], onDelete: SetNull)
  assetBucket AssetBucket? @relation(fields: [assetBucketId], references: [id], onDelete: SetNull)
  warnings    AssetWarning[]
  metaMedia     MetaMedia?
  metaCreatives MetaCreative[]
  streamQueue   StreamQueue[]
  adPublishJobs AdPublishJob[]
  assetIntelligence   AssetIntelligence?
  videoGenerationJobs VideoGenerationJob[]
  geoDataSource       GeoDataSource?
  aeoPageSources      AeoPageSource[]

  @@index([companyId])
  @@index([bulkUploadId])
  @@index([assetBucketId])
  @@index([assetType])
  @@index([status])
  @@index([intelligenceStatus])
  @@index([assetType, companyId])
  @@index([createdAt(sort: Desc)])
  @@map("assets")
}

model AssetIntelligence {
  id                String          @id @default(cuid())
  assetId           String
  language          String?         @db.VarChar(10)
  contentType       String?         @db.VarChar(100)
  durationSeconds   Int?
  theme             String?         @db.VarChar(255)
  sentiment         String?         @db.VarChar(50)
  intensityScore    Float?
  spiritualElements Boolean         @default(false)
  titlePrimary      String?         @db.VarChar(500)
  shortSummary      String?
  longDescription   String?
  tags              String[]        @default([])
  tone              String[]        @default([])
  topics            String[]        @default([])
  targetAudience    String[]        @default([])
  bestPlatforms     String[]        @default([])
  visualContext     String[]        @default([])
  videoGenres       String[]        @default([])
  titleVariants     Json?           @default("{}")
  chapters          Json?           @default("[]")
  shortsHooks       Json?           @default("[]")
  missRobustaInsights   Json?           @default("[]")
  modelVersion      String?         @db.VarChar(50)
  confidence        Float?
  processedAt       DateTime        @default(now()) @db.Timestamptz(3)
  companyId         String
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aeoPageSources    AeoPageSource[]

  @@unique([assetId])
  @@index([assetId])
  @@index([companyId])
  @@index([language])
  @@index([sentiment])
  @@index([theme])
  @@index([contentType])
  @@index([spiritualElements])
  @@index([processedAt(sort: Desc)])
  @@map("asset_intelligence")
}


model StreamQueue {
  id          String            @id @default(cuid())
  assetId     String
  r2Key       String            @db.VarChar(500)
  r2Bucket    String            @db.VarChar(255)
  status      StreamQueueStatus @default(PENDING)
  priority    StreamQueuePriority @default(NORMAL)
  attempts    Int               @default(0)
  maxAttempts Int               @default(3)
  streamId    String?           @db.VarChar(255)
  lastError   String?           @db.Text
  startedAt   DateTime?         @db.Timestamptz(3)
  completedAt DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@index([priority, createdAt])
  @@map("stream_queues")
}

model AssetWarning {
  id          String             @id @default(cuid())
  assetId     String
  warningType AssetWarningType
  detail      String?            @db.Text
  resolved    Boolean            @default(false)
  resolution  WarningResolution?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([assetId, resolved])
  @@map("asset_warnings")
}

model UploadSession {
  id            String   @id @default(cuid())
  uploadId      String   @db.VarChar(1000)  // ← was 255, R2 UploadId is long
  key           String   @db.VarChar(1000)
  fileName      String   @db.VarChar(1000)   // ← was 255, allow longer filenames
  fileSize      BigInt
  fileType      String   @db.VarChar(200)
  totalParts    Int
  uploadedParts Int[]    @default([])
  status        String   @db.VarChar(50)
  companyId     String?  @db.VarChar(255)
  uploadedBy    String?  @db.VarChar(255)
  metadata      String?
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([uploadedBy])
  @@index([companyId])
  @@map("upload_sessions")
}

// ================================================================
// META INTEGRATION
// ================================================================

model MetaIntegration {
  id            String   @id @default(cuid())
  companyId     String   @unique
  /// AES-256 encrypted
  accessToken   String   @db.Text
  /// Format: act_XXXXXXXXX (null until saved in workspace settings)
  adAccountId   String?  @db.VarChar(100)
  /// Numeric Facebook page id (null until saved in workspace settings)
  fbPageId      String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  /// Extracted tone, style, hook patterns from best performing ads
  brandVoice       Json?
  /// Top 5 ad copy + why they worked
  topAdExamples    Json?
  /// What targeting/demographics performed best
  audienceInsights Json?
  avgWinningCtr    Float?
  contextBuiltAt   DateTime? @db.Timestamptz(3)

  winningFormula        Json?     @map("winning_formula")
  winningFormulaBuiltAt DateTime? @map("winning_formula_built_at") @db.Timestamptz(3)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]
  creatives MetaCreative[]
  media     MetaMedia[]
  adSets    MetaAdSet[]
  ads       MetaAd[]

  @@index([companyId])
  @@map("meta_integrations")
}

// ================================================================
// GOOGLE ADS INTEGRATION
// ================================================================

model GoogleAdsIntegration {
  id               String    @id @default(cuid())
  companyId        String    @unique
  /// AES-256 encrypted OAuth refresh token
  refreshToken     String    @db.Text
  /// Google Ads customer ID (no dashes, e.g. 1234567890)
  customerId       String?   @db.VarChar(30)
  /// MCC / manager account ID used to access customerId
  loginCustomerId  String?   @db.VarChar(30)
  /// Google Ads conversion action resource name
  conversionActionId String? @db.VarChar(200)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns       GoogleCampaign[]
  adGroups        GoogleAdGroup[]
  assetGroups     GoogleAssetGroup[]
  creatives       GoogleCreative[]
  media           GoogleMedia[]
  ads             GoogleAd[]
  publishJobs     GoogleAdPublishJob[]

  @@index([companyId])
  @@map("google_ads_integrations")
}

model GoogleCampaign {
  id                    String    @id @default(cuid())
  googleAdsIntegrationId String
  googleCampaignId      String    @db.VarChar(100)
  campaignPresetId      String?
  name                  String    @db.VarChar(500)
  /// SEARCH | DISPLAY | PERFORMANCE_MAX
  campaignType          String    @db.VarChar(30)
  /// ACTIVE | PAUSED | REMOVED
  status                String    @db.VarChar(50)
  /// MAXIMIZE_CONVERSIONS | MAXIMIZE_CONVERSION_VALUE | TARGET_CPA | TARGET_ROAS | MANUAL_CPC | TARGET_IMPRESSION_SHARE
  biddingStrategy       String?   @db.VarChar(64)
  dailyBudgetMicros     BigInt?
  totalBudgetMicros     BigInt?
  targetCpaMicros       BigInt?
  targetRoas            Float?
  publishedAt           DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  googleAdsIntegration  GoogleAdsIntegration  @relation(fields: [googleAdsIntegrationId], references: [id], onDelete: Cascade)
  campaignPreset        GoogleCampaignPreset? @relation(fields: [campaignPresetId], references: [id], onDelete: SetNull)
  adGroups              GoogleAdGroup[]
  assetGroups           GoogleAssetGroup[]
  publishJobs           GoogleAdPublishJob[]

  @@unique([googleAdsIntegrationId, googleCampaignId])
  @@index([googleAdsIntegrationId])
  @@index([googleCampaignId])
  @@map("google_campaigns")
}

model GoogleAdGroup {
  id                     String    @id @default(cuid())
  googleAdsIntegrationId String
  campaignId             String
  googleAdGroupId        String    @db.VarChar(100)
  adGroupPresetId        String?
  name                   String?   @db.VarChar(500)
  /// ACTIVE | PAUSED | REMOVED
  status                 String?   @db.VarChar(50)
