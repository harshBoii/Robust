// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================================================
// CORE TENANT
// ================================================================

model Company {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String?
  logoUrl     String? @db.VarChar(1000)
  website     String? @db.VarChar(500)
  linkedinUrl String? @map("linkedin_url") @db.VarChar(1000)
  domain      String? @db.VarChar(255)
  email       String? @unique @db.VarChar(255)
  userName    String? @unique @db.VarChar(255)
  password    String? @db.VarChar(255)

  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret") @db.Text

  // Subscription
  subscriptionId        String?            @map("subscription_id")
  subscriptionStatus    SubscriptionStatus @default(PENDING) @map("subscription_status")
  subscriptionCreatedAt DateTime?          @map("subscription_created_at")
  subscriptionUpdatedAt DateTime?          @map("subscription_updated_at")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  metaIntegration    MetaIntegration?
  integrationCms     CompanyIntegrationCms[]
  shopifyShops       ShopifyShop[]
  shopifyProducts    ShopifyProduct[]
  assets             Asset[]
  bulkUploads        BulkUpload[]
  assetBuckets       AssetBucket[]
  adPresets          AdPreset[]
  adsetPresets       AdsetPreset[]
  campaignPresets    CampaignPreset[]
  adSchedules        AdSchedule[]
  adAutomationRules  AdAutomationRule[]
  adAutomationEvents AdAutomationEvent[]
  notifications      Notification[]
  adPublishJobs      AdPublishJob[]
  assistantCreativeUsage AssistantCreativeUsage[]
  adChatSessions     AdChatSession[]
  authSessions       AuthSession[]
  loginActivities    LoginActivity[]
  brandEntity        BrandEntity?
  offerings          Offering[]
  assetIntelligences AssetIntelligence[]
  videoGenerationJobs VideoGenerationJob[]
  aeoGenerationProfiles   AeoGenerationProfile[]
  aeoPages                AeoPage[]
  citationBounties        CitationBounty[]
  contentClusters         ContentCluster[]
  geoDataSources          GeoDataSource[]
  Citations               Citation[]
  LlmRadarMetrics         LlmRadarMetric[]
  llmTopics               LlmTopic[]
  radarAssumption         RadarAssumption?
  llmPromptMetrics        LlmPromptMetric[]
  rivals                  CompanyRival[] @relation("CompanyRivals")
  rivalOf                 CompanyRival[] @relation("CompanyRivalTargets")
  shopifyBlogChannels     ShopifyBlogChannel[]



  @@index([slug])
  @@map("companies")
}

// ================================================================
// DATA MINE (company seed / brand enrichment)
// ================================================================

model BrandEntity {
  id                  String   @id @default(cuid())
  companyId           String   @unique @map("company_id")
  canonicalName       String   @map("canonical_name") @db.VarChar(255)
  aliases             String[] @default([])
  entityType          String?  @map("entity_type") @db.VarChar(64)
  oneLiner            String?  @map("one_liner") @db.Text
  about               String?  @db.Text
  industry            String?  @db.VarChar(255)
  category            String?  @db.VarChar(255)
  headquartersCity    String?  @map("headquarters_city") @db.VarChar(255)
  headquartersCountry String?  @map("headquarters_country") @db.VarChar(255)
  foundedYear         Int?     @map("founded_year")
  employeeRange       String?  @map("employee_range") @db.VarChar(64)
  businessModel       String?  @map("business_model") @db.VarChar(64)
  topics              String[] @default([])
  keywords            String[] @default([])
  targetAudiences     String[] @default([]) @map("target_audiences")
  branding            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offerings             Offering[]
  aeoGenerationProfiles AeoGenerationProfile[]

  @@map("brand_entities")
}

model Offering {
  id              String       @id @default(cuid())
  companyId       String       @map("company_id")
  brandEntityId   String       @map("brand_entity_id")
  name            String       @db.VarChar(500)
  slug            String       @db.VarChar(255)
  description     String?      @db.Text
  offeringType    OfferingType @default(PRODUCT) @map("offering_type")
  url             String?      @db.VarChar(1000)
  keywords        String[]     @default([])
  useCases        String[]     @default([]) @map("use_cases")
  targetAudiences String[]     @default([]) @map("target_audiences")
  differentiators String[]     @default([])
  competitors     String[]     @default([])
  isPrimary       Boolean      @default(false) @map("is_primary")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)

  @@unique([brandEntityId, slug])
  @@index([companyId])
  @@map("offerings")
}

model AuthSession {
  id         String    @id @default(cuid())
  companyId  String
  userAgent  String?   @db.VarChar(500)
  ipAddress  String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginActivity {
  id        String   @id @default(cuid())
  companyId String?
  success   Boolean
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("login_activities")
}

// ================================================================
// AD CHAT (conversational ad posting)
// ================================================================

model AdChatSession {
  id              String              @id @default(cuid())
  companyId       String
  createdByUserId String?             @db.VarChar(255)
  title           String              @default("New chat") @db.VarChar(500)
  status          AdChatSessionStatus @default(ACTIVE)
  pathType        ChatPathType?
  currentStep     String              @default("intent") @db.VarChar(64)
  workflowState   Json                @default("{}")
  bulkUploadId    String?
  campaignId      String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages AdChatMessage[]

  @@index([companyId])
  @@index([companyId, updatedAt(sort: Desc)])
  @@map("ad_chat_sessions")
}

model AdChatMessage {
  id            String            @id @default(cuid())
  sessionId     String
  role          AdChatMessageRole
  content       String?
  widgetType    String?           @db.VarChar(64)
  widgetPayload Json?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  session AdChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("ad_chat_messages")
}

/// Per-company daily counter for vision creative-suggest API
model AssistantCreativeUsage {
  companyId String
  date      DateTime @db.Date
  count     Int      @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, date])
  @@map("assistant_creative_usage")
}

// ================================================================
// ASSETS & GALLERY
// ================================================================

model BulkUpload {
  id        String           @id @default(cuid())
  companyId String
  name      String           @db.VarChar(255)
  status    BulkUploadStatus @default(PROCESSING)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets       Asset[]
  assetBuckets AssetBucket[]

  @@index([companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("bulk_uploads")
}

model AssetBucket {
  id           String     @id @default(cuid())
  companyId    String
  bulkUploadId String
  label        String     @db.VarChar(255)
  bucketType   BucketType
  bucketValue  String     @db.VarChar(255)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bulkUpload BulkUpload @relation(fields: [bulkUploadId], references: [id], onDelete: Cascade)
  assets     Asset[]

  @@index([companyId])
  @@index([bulkUploadId])
  @@map("asset_buckets")
}

model Asset {
  id            String       @id @default(cuid())
  companyId     String
  bulkUploadId  String?
  assetBucketId String?
  assetType     AssetType
  title         String       @db.VarChar(500)
  filename      String       @db.VarChar(500)
  originalSize  BigInt
  status              AssetStatus         @default(UPLOADING)
  intelligenceStatus  IntelligenceStatus  @default(NONE)
  r2Key         String       @db.VarChar(500)
  r2Bucket      String       @db.VarChar(255)
  resolution    String?      @db.VarChar(20)
  mimeType      String?      @db.VarChar(100)
  duration      Int?
  fps           Int?
  codec         String?      @db.VarChar(50)
  streamId      String?      @unique @db.VarChar(255)
  playbackUrl   String?      @db.VarChar(2000)
  thumbnailUrl  String?      @db.VarChar(1000)
  tags          String[]     @default([])
  metadata      Json         @default("{}")
  uploadSource  UploadSource @default(NATIVE)
  videoHash     String?      @db.VarChar(300)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bulkUpload  BulkUpload?  @relation(fields: [bulkUploadId], references: [id], onDelete: SetNull)
  assetBucket AssetBucket? @relation(fields: [assetBucketId], references: [id], onDelete: SetNull)
  warnings    AssetWarning[]
  metaMedia     MetaMedia?
  metaCreatives MetaCreative[]
  streamQueue   StreamQueue[]
  adPublishJobs AdPublishJob[]
  assetIntelligence   AssetIntelligence?
  videoGenerationJobs VideoGenerationJob[]
  geoDataSource       GeoDataSource?
  aeoPageSources      AeoPageSource[]

  @@index([companyId])
  @@index([bulkUploadId])
  @@index([assetBucketId])
  @@index([assetType])
  @@index([status])
  @@index([intelligenceStatus])
  @@index([assetType, companyId])
  @@index([createdAt(sort: Desc)])
  @@map("assets")
}

model AssetIntelligence {
  id                String          @id @default(cuid())
  assetId           String
  language          String?         @db.VarChar(10)
  contentType       String?         @db.VarChar(100)
  durationSeconds   Int?
  theme             String?         @db.VarChar(255)
  sentiment         String?         @db.VarChar(50)
  intensityScore    Float?
  spiritualElements Boolean         @default(false)
  titlePrimary      String?         @db.VarChar(500)
  shortSummary      String?
  longDescription   String?
  tags              String[]        @default([])
  tone              String[]        @default([])
  topics            String[]        @default([])
  targetAudience    String[]        @default([])
  bestPlatforms     String[]        @default([])
  visualContext     String[]        @default([])
  videoGenres       String[]        @default([])
  titleVariants     Json?           @default("{}")
  chapters          Json?           @default("[]")
  shortsHooks       Json?           @default("[]")
  missRobustaInsights   Json?           @default("[]")
  modelVersion      String?         @db.VarChar(50)
  confidence        Float?
  processedAt       DateTime        @default(now()) @db.Timestamptz(3)
  companyId         String
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aeoPageSources    AeoPageSource[]

  @@unique([assetId])
  @@index([assetId])
  @@index([companyId])
  @@index([language])
  @@index([sentiment])
  @@index([theme])
  @@index([contentType])
  @@index([spiritualElements])
  @@index([processedAt(sort: Desc)])
  @@map("asset_intelligence")
}


model StreamQueue {
  id          String            @id @default(cuid())
  assetId     String
  r2Key       String            @db.VarChar(500)
  r2Bucket    String            @db.VarChar(255)
  status      StreamQueueStatus @default(PENDING)
  priority    StreamQueuePriority @default(NORMAL)
  attempts    Int               @default(0)
  maxAttempts Int               @default(3)
  streamId    String?           @db.VarChar(255)
  lastError   String?           @db.Text
  startedAt   DateTime?         @db.Timestamptz(3)
  completedAt DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@index([priority, createdAt])
  @@map("stream_queues")
}

model AssetWarning {
  id          String             @id @default(cuid())
  assetId     String
  warningType AssetWarningType
  detail      String?            @db.Text
  resolved    Boolean            @default(false)
  resolution  WarningResolution?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([assetId, resolved])
  @@map("asset_warnings")
}

model UploadSession {
  id            String   @id @default(cuid())
  uploadId      String   @db.VarChar(1000)  // ← was 255, R2 UploadId is long
  key           String   @db.VarChar(1000)
  fileName      String   @db.VarChar(1000)   // ← was 255, allow longer filenames
  fileSize      BigInt
  fileType      String   @db.VarChar(200)
  totalParts    Int
  uploadedParts Int[]    @default([])
  status        String   @db.VarChar(50)
  companyId     String?  @db.VarChar(255)
  uploadedBy    String?  @db.VarChar(255)
  metadata      String?
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([uploadedBy])
  @@index([companyId])
  @@map("upload_sessions")
}

// ================================================================
// META INTEGRATION
// ================================================================

model MetaIntegration {
  id            String   @id @default(cuid())
  companyId     String   @unique
  /// AES-256 encrypted
  accessToken   String   @db.Text
  /// Format: act_XXXXXXXXX (null until saved in workspace settings)
  adAccountId   String?  @db.VarChar(100)
  /// Numeric Facebook page id (null until saved in workspace settings)
  fbPageId      String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  /// Extracted tone, style, hook patterns from best performing ads
  brandVoice       Json?
  /// Top 5 ad copy + why they worked
  topAdExamples    Json?
  /// What targeting/demographics performed best
  audienceInsights Json?
  avgWinningCtr    Float?
  contextBuiltAt   DateTime? @db.Timestamptz(3)

  winningFormula        Json?     @map("winning_formula")
  winningFormulaBuiltAt DateTime? @map("winning_formula_built_at") @db.Timestamptz(3)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]
  creatives MetaCreative[]
  media     MetaMedia[]
  adSets    MetaAdSet[]
  ads       MetaAd[]

  @@index([companyId])
  @@map("meta_integrations")
}

// ================================================================
// SHOPIFY INTEGRATION
// ================================================================

model CompanyIntegrationCms {
  id                 String              @id @default(cuid())
  companyId          String
  provider           IntegrationProvider
  apiKey             String?             @db.VarChar(255)
  apiSecret          String?             @db.Text
  scopes             String?             @db.Text
  appUrl             String?             @db.VarChar(1000)
  connectUrl         String?             @db.VarChar(1000)
  expectedShopDomain String?             @unique @db.VarChar(255)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("company_integration_cms")
}

model ShopifyShop {
  id            String    @id @default(cuid())
  companyId     String
  shopDomain    String    @unique @db.VarChar(255)
  accessToken   String    @db.Text
  scopes        String?   @db.Text
  status        String    @default("installed") @db.VarChar(32)
  uninstalledAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products      ShopifyProduct[]
  blogChannels  ShopifyBlogChannel[]
  @@index([companyId])
  @@map("shopify_shops")
}

model ShopifyProduct {
  id                  String    @id @default(cuid())
  shopifyGid          String    @unique @db.VarChar(255)
  shopId              String
  companyId           String
  title               String    @default("") @db.VarChar(500)
  status              String?   @db.VarChar(64)
  handle              String?   @db.VarChar(255)
  totalInventory      Int?
  onlineStoreUrl      String?   @db.VarChar(1000)
  description         String?   @db.Text
  featuredImageUrl    String?   @db.VarChar(1000)
  featuredImageAltText String?  @db.VarChar(500)
  featuredImageWidth  Int?
  featuredImageHeight Int?
  priceMinAmount      Decimal?  @db.Decimal(18, 4)
  priceMaxAmount      Decimal?  @db.Decimal(18, 4)
  currencyCode        String?   @db.VarChar(16)
  shopifyCreatedAt    DateTime? @db.Timestamptz(3)
  shopifyUpdatedAt    DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  shop    ShopifyShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([shopId])
  @@index([companyId, shopifyUpdatedAt(sort: Desc)])
  @@map("shopify_products")
}

model ShopifyBlogChannel {
  id             String   @id @default(cuid())
  shopId         String
  companyId      String
  handle         String   @db.VarChar(255)
  title          String   @db.VarChar(255)
  shopifyBlogGid String   @unique @db.VarChar(255)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  shop    ShopifyShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([shopId, handle])
  @@index([shopId])
  @@index([companyId])
  @@map("shopify_blog_channels")
}


model MetaMedia {
  id                String   @id @default(cuid())
  metaIntegrationId String
  /// "image" | "video"
  kind              String   @db.VarChar(10)
  imageHash         String?  @db.VarChar(200)
  videoId           String?  @db.VarChar(100)
  /// Ad account (`act_…`) this media was uploaded to on Meta; used to avoid cross-account reuse.
  uploadedAdAccountId String? @db.VarChar(50)
  assetId           String?  @unique
  imageUrl          String?  @db.VarChar(1000)
  videoUrl          String?  @db.VarChar(1000)
  videoStreamId     String?  @db.VarChar(100)
  thumbnailUrl      String?  @db.VarChar(1000)
  r2Key             String?  @db.VarChar(500)
  filename          String?  @db.VarChar(500)
  mimeType          String?  @db.VarChar(200)
  bytes             Int?
  width             Int?
  height            Int?
  durationMs        Int?
  /// uploading | processing | ready | error
  status            String   @default("ready") @db.VarChar(20)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([metaIntegrationId, imageHash])
  @@unique([metaIntegrationId, videoId])
  @@index([metaIntegrationId])
  @@index([imageHash])
  @@index([videoId])
  @@map("meta_media")
}

model MetaCampaign {
  id                  String    @id @default(cuid())
  metaIntegrationId   String
  metaCampaignId      String    @db.VarChar(100)
  campaignPresetId    String?
  name                String    @db.VarChar(500)
  /// OUTCOME_TRAFFIC, OUTCOME_SALES, OUTCOME_LEADS etc.
  objective           String    @db.VarChar(100)
  /// ACTIVE | PAUSED | ARCHIVED
  status              String    @db.VarChar(50)
  /// In smallest currency unit; 0 when budget lives on ad set
  dailyBudget         Int       @default(0)
  lifetimeBudget      Int?
  spendCap            BigInt?
  specialAdCategory   String?   @db.VarChar(100)
  specialAdCategories Json?     @default("[]")
  bidStrategy         String?   @db.VarChar(64)
  publishedAt         DateTime? @db.Timestamptz(3)
  reviewStatus        String?   @db.VarChar(50)
  reviewFeedback      String?   @db.Text
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  campaignPreset  CampaignPreset? @relation(fields: [campaignPresetId], references: [id], onDelete: SetNull)
  creatives       MetaCreative[]
  adSets          MetaAdSet[]
  adsetPresets    AdsetPreset[]
  publishJobs     AdPublishJob[]


  @@unique([metaIntegrationId, metaCampaignId])
  @@index([metaIntegrationId])
  @@index([metaCampaignId])
  @@index([campaignPresetId])
  @@map("meta_campaigns")
}

model MetaCreative {
  id                  String    @id @default(cuid())
  metaIntegrationId   String
  /// Optional link when creative was created for a campaign-level flow
  metaCampaignId      String?
  /// Gallery asset used for image_hash / video_id
  assetId             String?
  /// Returned by Meta after adcreatives POST
  metaCreativeId      String?   @db.VarChar(100)
  imageHash           String?   @db.VarChar(200)
  videoId             String?   @db.VarChar(100)
  headline            String    @db.VarChar(500)
  primaryText         String    @db.Text
  description         String?   @db.Text
  ctaType             String    @db.VarChar(100)
  landingUrl          String    @db.VarChar(2000)
  imageUrl            String?   @db.VarChar(1000)
  imagePrompt         String?   @db.Text
  videoUrl            String?   @db.VarChar(1000)
  videoPrompt         String?   @db.Text
  videoStreamId       String?   @db.VarChar(100)
  thumbnailUrl        String?   @db.VarChar(1000)
  aiGenerated         Boolean   @default(true)
  compliancePassed    Boolean   @default(false)
  complianceFlags     Json?
  complianceCheckedAt DateTime? @db.Timestamptz(3)
  approvedByUser      Boolean   @default(false)
  approvedAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  campaign        MetaCampaign?   @relation(fields: [metaCampaignId], references: [id], onDelete: SetNull)
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  ads             MetaAd[]

  @@unique([metaIntegrationId, metaCreativeId])
  @@index([metaIntegrationId])
  @@index([metaCreativeId])
  @@index([metaCampaignId])
  @@index([assetId])
  @@map("meta_creatives")
}

model MetaAdSet {
  id                String    @id @default(cuid())
  metaIntegrationId String
  campaignId        String
  adsetPresetId     String?
  metaAdSetId       String    @db.VarChar(100)
  name              String?   @db.VarChar(500)
  /// ACTIVE | PAUSED | ARCHIVED
  status            String?   @db.VarChar(50)
  dailyBudget       Int?
  lifetimeBudget    Int?
  bidStrategy       String?   @db.VarChar(64)
  bidAmount         Int?
  bidConstraints    Json?     @default("{}")
  optimizationGoal  String?   @db.VarChar(100)
  billingEvent      String?   @db.VarChar(50)
  /// Full Meta targeting object
  targeting         Json?
  startTime         DateTime? @db.Timestamptz(3)
  endTime           DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  campaign        MetaCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adsetPreset     AdsetPreset?    @relation(fields: [adsetPresetId], references: [id], onDelete: SetNull)
  ads             MetaAd[]
  publishJobs      AdPublishJob[]

  @@unique([metaIntegrationId, metaAdSetId])
  @@index([campaignId])
  @@index([metaIntegrationId])
  @@index([adsetPresetId])
  @@map("meta_ad_sets")
}

model MetaAd {
  id                String    @id @default(cuid())
  metaIntegrationId String
  adSetId           String
  metaCreativeDbId  String?
  metaAdId          String    @db.VarChar(100)
  name              String?   @db.VarChar(500)
  /// ACTIVE | PAUSED | ARCHIVED
  status            String?   @db.VarChar(50)
  presetId          String?
  scheduleId        String?
  /// Self-relation: tracks which ad this was duplicated from
  duplicatedFromId  String?
  publishedAt       DateTime? @db.Timestamptz(3)
  reviewStatus      String?   @db.VarChar(50)
  reviewFeedback    String?   @db.Text
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  adSet           MetaAdSet       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative        MetaCreative?   @relation(fields: [metaCreativeDbId], references: [id], onDelete: SetNull)
  preset          AdPreset?       @relation(fields: [presetId], references: [id], onDelete: SetNull)
  schedule        AdSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  duplicatedFrom  MetaAd?         @relation("MetaAdDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates      MetaAd[]        @relation("MetaAdDuplicate")
  publishJobs     AdPublishJob[]

  @@unique([metaIntegrationId, metaAdId])
  @@index([adSetId])
  @@index([metaIntegrationId])
  @@index([presetId])
  @@index([scheduleId])
  @@index([duplicatedFromId])
  @@map("meta_ads")
}

/// Polled every 6h from Meta Insights API — one row per ad per date preset
model MetaAdMetrics {
  id             String   @id @default(cuid())
  metaCampaignId String
  metaAdId       String   @db.VarChar(100)
  impressions    Int
  clicks         Int
  ctr            Float
  spend          Float
  cpc            Float?
  roas           Float?
  /// 3-second view rate — video ads only
  hookRate       Float?
  /// Computed: (today - publishedAt).days
  daysRunning    Int?
  /// FATIGUE | UNDERPERFORMER | WINNER — set by automation rule evaluator
  statusSignal   String?  @db.VarChar(64)
  actions        Json?
  /// "last_7d" | "last_30d" | "lifetime"
  datePreset     String   @db.VarChar(50)
  recordedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([metaCampaignId])
  @@index([metaAdId])
  @@index([metaAdId, datePreset])
  @@index([recordedAt(sort: Desc)])
  @@map("meta_ad_metrics")
}

// ================================================================
// PRESETS
// ================================================================

/// Ad-level creative preset: headline, landing URL, audience basics, pixel IDs
model AdPreset {
  id                String   @id @default(cuid())
  companyId         String
  name              String   @db.VarChar(120)
  isDefault         Boolean  @default(false)
  headline          String?  @db.VarChar(500)
  landingPageUrl    String?  @db.VarChar(2000)
  budgetOverride    Float?
  targetAgeMin      Int?
  targetAgeMax      Int?
  targetGenders     String[] @default([])
  targetProfessions String[] @default([])
  pixelIds          String[] @default([])
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metaAds MetaAd[]
  publishJobs AdPublishJob[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("ad_presets")
}

/// Adset-level preset: budget, bidding strategy, full Meta targeting object
model AdsetPreset {
  id             String    @id @default(cuid())
  companyId      String
  name           String    @db.VarChar(120)
  isDefault      Boolean   @default(false)
  dailyBudget    BigInt?
  lifetimeBudget BigInt?
  /// Legacy absolute schedule; prefer scheduleDuration + scheduleCustomEnd
  startTime      DateTime?
  endTime        DateTime?
  /// 3_days | 1_week | 1_month | custom — end is computed at ad set creation time
  scheduleDuration   String?   @db.VarChar(32)
  /// Required when scheduleDuration is custom
  scheduleCustomEnd  DateTime? @db.Timestamptz(3)
  billingEvent     String?  @db.VarChar(64)
  optimizationGoal String?  @db.VarChar(100)
  destinationType  String?  @db.VarChar(64)
  bidStrategy    String?   @db.VarChar(64)
  bidAmount      BigInt?
  isDefaultCreative Boolean @default(false)
  pacingType        String? @db.VarChar(32)
  promotedObject    Json?   @default("{}")
  attributionSpec   Json?   @default("[]")
  pinnedCampaignId  String?
  bidConstraints Json?     @default("{}")
  /// Full Meta targeting object stored as JSON — passed directly to API
  targeting      Json?     @default("{}")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pinnedCampaign MetaCampaign? @relation(fields: [pinnedCampaignId], references: [id], onDelete: SetNull)
  adSets  MetaAdSet[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@index([pinnedCampaignId])
  @@map("adset_presets")
}

/// Campaign-level preset: objective, spend cap, bid strategy, special ad categories
model CampaignPreset {
  id                  String   @id @default(cuid())
  companyId           String
  name                String   @db.VarChar(120)
  isDefault           Boolean  @default(false)
  objective           String?  @db.VarChar(64)
  status              String?  @db.VarChar(32)
  spendCap            BigInt?
  dailyBudget         BigInt?
  lifetimeBudget      BigInt?
  bidStrategy                  String?  @db.VarChar(64)
  specialAdCategories          Json?    @default("[]")
  /// Required by Meta when campaign has no daily/lifetime budget (ad-set budgets). null = CBO / not applicable.
  isAdsetBudgetSharingEnabled  Boolean?
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("campaign_presets")
}

// ================================================================
// SCHEDULING & AUTOMATION
// ================================================================

model AdSchedule {
  id          String           @id @default(cuid())
  companyId   String
  scheduledAt DateTime         @db.Timestamptz(3)
  status      AdScheduleStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ads     MetaAd[]
  publishJobs AdPublishJob[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([scheduledAt])
  @@map("ad_schedules")
}

// ================================================================
// PUBLISH JOBS (META)
// ================================================================

model AdPublishJob {
  id                 String           @id @default(cuid())
  companyId          String
  metaIntegrationId  String
  campaignId         String
  adSetId            String
  assetId            String
  adPresetId         String?
  scheduleId         String?
  status             PublishJobStatus @default(QUEUED)
  attempts           Int              @default(0)
  maxAttempts        Int              @default(3)
  scheduledAt        DateTime?        @db.Timestamptz(3)
  startedAt          DateTime?        @db.Timestamptz(3)
  completedAt        DateTime?        @db.Timestamptz(3)
  lastError          String?          @db.Text
  metaCreativeDbId   String?
  metaAdDbId         String?
  duplicatedFromAdId String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  headlineOverride    String? @db.VarChar(500)
  primaryTextOverride String? @db.Text
  descriptionOverride String? @db.Text
  landingUrlOverride  String? @db.VarChar(2000)
  ctaTypeOverride     String? @db.VarChar(100)
  pixelIdOverride     String? @db.VarChar(100)
  groupKey            String? @db.VarChar(120)

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet    MetaAdSet   @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  asset    Asset       @relation(fields: [assetId], references: [id])
  adPreset AdPreset?   @relation(fields: [adPresetId], references: [id], onDelete: SetNull)
  schedule AdSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  metaAd   MetaAd?     @relation(fields: [metaAdDbId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([scheduledAt, status])
  @@index([scheduleId])
  @@index([metaIntegrationId])
  @@index([campaignId])
  @@index([adSetId])
  @@index([assetId])
  @@index([adPresetId])
  @@index([metaAdDbId])
  @@map("ad_publish_jobs")
}

// ================================================================
// HEYGEN VIDEO GENERATION
// ================================================================

model VideoGenerationJob {
  id              String            @id @default(cuid())
  companyId       String
  script          String            @db.Text
  avatarId        String            @default("auto") @db.VarChar(64)
  voiceId         String            @default("auto") @db.VarChar(64)
  heygenStatus    VideoGenJobStatus @default(PENDING)
  heygenError     String?           @db.Text
  heygenVideoId   String?           @db.VarChar(255)
  progressMessage String?           @db.VarChar(500)
  downloadUrl     String?           @db.VarChar(2000)
  playbackUrl     String?           @db.VarChar(2000)
  thumbnailUrl    String?           @db.VarChar(1000)
  assetId         String?
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([companyId, heygenStatus])
  @@index([heygenVideoId])
  @@index([assetId])
  @@map("video_generation_jobs")
}

/// One rule per type per company — toggled on/off via UI
model AdAutomationRule {
  id               String    @id @default(cuid())
  companyId        String
  ruleType         RuleType
  isEnabled        Boolean   @default(true)
  /// Numeric trigger threshold (e.g. CPI ceiling, CTR drop %)
  threshold        Float?
  /// Lookback / evaluation window in days
  window           Int?
  lastTriggeredAt  DateTime? @db.Timestamptz(3)
  requiresApproval Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  AdAutomationEvent[]

  @@unique([companyId, ruleType])
  @@index([companyId])
  @@map("ad_automation_rules")
}

/// Audit log of every rule-triggered action
model AdAutomationEvent {
  id          String         @id @default(cuid())
  companyId   String
  ruleId      String
  /// Meta ad id
  adId        String         @db.VarChar(100)
  actionTaken AutoActionType
  details     Json           @default("{}")
  /// null = pending approval | true = approved | false = rejected
  approved    Boolean?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule          AdAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([companyId])
  @@index([ruleId])
  @@index([adId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("ad_automation_events")
}

/// UI notification bell — one row per user-facing alert
model Notification {
  id        String    @id @default(cuid())
  companyId String
  /// FK to AdAutomationEvent — nullable for manual/system notifications
  eventId   String?
  /// AUTO_PAUSE | FATIGUE_ALERT | BUDGET_PACING | SPEND_CONCENTRATION | WINNER_AMPLIFICATION
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event   AdAutomationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// ================================================================
// Immortell Tables
// ================================================================
model AeoPage {
  id                String        @id @default(cuid())
  companyId         String
  slug              String        @db.VarChar(255)
  locale            String        @default("en") @db.VarChar(10)
  pageType          AeoPageType   @default(DEFINITION)
  status            AeoPageStatus @default(DRAFT)
  title             String        @db.VarChar(500)
  description       String
  facts             Json          @default("[]")
  faq               Json          @default("[]")
  claims            Json          @default("[]")
  summary           Json          @default("{}")
  knowledgeGraph    Json          @default("{}")
  seoTitle          String?       @db.VarChar(500)
  seoDescription    String?
  canonicalUrl      String?       @db.VarChar(1000)
  /// Shopify Admin API GID for the blog article when published via approve-shopify
  shopifyArticleGid String?       @db.VarChar(255)
  clusterId         String?
  publishedAt       DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  llm_prompt_id String?
  llm_prompt    Prompt? @relation(fields: [llm_prompt_id], references: [id])

  llm_topic_id String?
  llm_topic    LlmTopic? @relation(fields: [llm_topic_id], references: [id])

  generationProfiles AeoGenerationProfile[]
  sources            AeoPageSource[]
  cluster            ContentCluster?        @relation("ClusterPages", fields: [clusterId], references: [id])
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  citationBounties   CitationBounty?
  pillarFor          ContentCluster?        @relation("PillarPage")
  aeo_pages_A        AeoPage[]              @relation("RelatedAeoPages")
  aeo_pages_B        AeoPage[]              @relation("RelatedAeoPages")

  @@unique([companyId, slug, locale])
  @@index([companyId])
  @@index([status])
  @@index([pageType])
  @@index([clusterId])
  @@index([companyId, status])
  @@index([publishedAt(sort: Desc)])
  @@map("aeo_pages")
}

model GeoDataSource {
  id               String        @id @default(cuid())
  companyId        String
  sourceType       GeoSourceType
  label            String        @db.VarChar(255)
  assetId          String?       @unique
  rawContent       String?
  processedContent String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  asset            Asset?        @relation(fields: [assetId], references: [id])
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sourceType])
  @@map("geo_data_sources")
}

model AeoGenerationProfile {
  id                     String       @id @default(cuid())
  companyId              String
  brandEntityId          String?
  baseUrl                String       @db.VarChar(1000)
  locale                 String       @default("en") @db.VarChar(10)
  clusterId              String?      @db.VarChar(255)
  existingSlugs          String[]     @default([])
  defaultPageType        AeoPageType  @default(COMPARISON)
  defaultQuery           String?
  label                  String?      @db.VarChar(255)
  slug                   String?      @db.VarChar(255)
  lastGeneratedAeoPageId String?
  lastRunAt              DateTime?    @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)
  brandEntity            BrandEntity? @relation(fields: [brandEntityId], references: [id])
  company                Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lastGeneratedAeoPage   AeoPage?     @relation(fields: [lastGeneratedAeoPageId], references: [id])

  @@index([companyId])
  @@index([brandEntityId])
  @@index([defaultPageType])
  @@map("aeo_generation_profiles")
}

model AeoPageSource {
  id                String             @id @default(cuid())
  pageId            String
  assetId           String?
  intelligenceId    String?
  contributionScore Float?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  asset             Asset?             @relation(fields: [assetId], references: [id])
  intelligence      AssetIntelligence? @relation(fields: [intelligenceId], references: [id])
  page              AeoPage            @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([assetId])
  @@map("aeo_page_sources")
}

model ContentCluster {
  id           String    @id @default(cuid())
  companyId    String
  name         String    @db.VarChar(255)
  slug         String    @db.VarChar(255)
  description  String?
  pillarPageId String?   @unique
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  pages        AeoPage[] @relation("ClusterPages")
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pillarPage   AeoPage?  @relation("PillarPage", fields: [pillarPageId], references: [id])

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("content_clusters")
}

model CompanyRival {
  id             String   @id @default(cuid())
  companyId      String
  rivalCompanyId String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  company        Company  @relation("CompanyRivals", fields: [companyId], references: [id], onDelete: Cascade)
  rivalCompany   Company  @relation("CompanyRivalTargets", fields: [rivalCompanyId], references: [id], onDelete: Cascade)

  @@unique([companyId, rivalCompanyId])
  @@index([companyId])
  @@index([rivalCompanyId])
  @@map("company_rivals")
}

model Citation {
  id            String          @id @default(cuid())
  executionId   String
  companyId     String?
  mentionedName String          @db.VarChar(255)
  rank          Int?
  context       String?         @db.VarChar(100)
  confidence    Float?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  company       Company?        @relation(fields: [companyId], references: [id])
  execution     PromptExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([companyId])
  @@index([rank])
  @@map("llm_citations")
}

model PromptExecution {
  id         String     @id @default(cuid())
  promptId   String
  model      String     @db.VarChar(100)
  response   String
  executedAt DateTime   @default(now()) @db.Timestamptz(3)
  citations  Citation[]
  prompt     Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([model])
  @@index([executedAt])
  @@map("llm_prompt_executions")
}

model Prompt {
  id              String   @id @default(cuid())
  query           String
  topic           String?  @db.VarChar(255)
  topicId         String?
  reason          String?
  expectedRevenue Float?
  intent          String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  ishunted        Boolean  @default(false)

  aeo_pages       AeoPage[]

  executions       PromptExecution[]
  llmTopic         LlmTopic?              @relation("LlmTopicPrompts", fields: [topicId], references: [id])
  llmPromptMetrics LlmPromptMetric[]
  revenue          PromptRevenue?
  rivalByModel     PromptRivalByModel[]
  rivalConsensus   PromptRivalConsensus[]

  @@index([intent])
  @@index([topic])
  @@index([topicId])
  @@map("llm_prompts")
}

model PromptRevenue {
  id                 String   @id @default(cuid())
  promptId           String   @unique
  monthlyPromptReach Float?
  visibilityWeight   Float?
  ctr                Float?
  cvr                Float?
  aov                Float?
  estimatedRevenue   Float?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  prompt             Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([estimatedRevenue])
  @@map("llm_prompt_revenues")
}

model LlmTopic {
  id               String            @id @default(cuid())
  name             String            @db.VarChar(255)
  description      String?
  reason           String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  difficulty       Difficulty        @default(MEDIUM)
  companyId        String
  prompts          Prompt[]          @relation("LlmTopicPrompts")
  llmPromptMetrics LlmPromptMetric[]
  aeo_pages        AeoPage[]
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("llm_topics")
}

model PromptRivalByModel {
  id          String   @id @default(cuid())
  promptId    String
  model       String   @db.VarChar(100)
  companyName String   @db.VarChar(255)
  rank        Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  prompt      Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, model, companyName])
  @@index([promptId])
  @@index([model])
  @@map("llm_prompt_rivals_by_model")
}

model PromptRivalConsensus {
  id          String   @id @default(cuid())
  promptId    String
  companyName String   @db.VarChar(255)
  avgRank     Float?
  mentions    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  prompt      Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, companyName])
  @@index([promptId])
  @@map("llm_prompt_rivals_consensus")
}

model LlmRadarMetric {
  id             String   @id @default(cuid())
  companyId      String
  model          String   @db.VarChar(100)
  shareOfVoice   Float?
  top3Rate       Float?
  queryCoverage  Float?
  avgRank        Float?
  calculatedAt   DateTime @default(now()) @db.Timestamptz(3)
  competitorRank Float?
  topicAuthority Float?
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([model])
  @@index([companyId, calculatedAt(sort: Desc)])
  @@map("llm_radar_metrics")
}

model LlmPromptMetric {
  id               String      @id @default(cuid())
  companyId        String
  promptId         String
  topicId          String?
  model            String      @db.VarChar(100)
  latestRank       Int?
  isMentioned      Boolean     @default(false)
  estimatedReach   Int?
  confidence       Float?
  difficulty       Difficulty?
  businessFit      Float?
  opportunityScore Float?
  estimatedRevenue Float?
  actionType       String?     @db.VarChar(32)
  rankTrend7d      Float?
  rankTrend30d     Float?
  modelGapFlag     Boolean     @default(false)
  calculatedAt     DateTime    @default(now()) @db.Timestamptz(3)
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prompt           Prompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  llmTopic         LlmTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([companyId, promptId, model])
  @@index([companyId])
  @@index([promptId])
  @@index([calculatedAt(sort: Desc)])
  @@map("llm_prompt_metrics")
}

/// Company-level CTR/CVR assumptions for prompt revenue estimates (edit UI later)
model RadarAssumption {
  id             String   @id @default(cuid())
  companyId      String   @unique
  /// Click-through from impression to site (ratio 0–1)
  ctr            Float    @default(0.02)
  /// Conversion to order (ratio 0–1), aligned with D2C defaults when unset on bounties
  cvr            Float    @default(0.025)
  aovMultiplier  Float    @default(1)
  industryPreset String?  @db.VarChar(50)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("radar_assumptions")
}

model CitationBounty {
  id                String           @id @default(cuid())
  companyId         String
  query             String
  intent            String?          @db.VarChar(255)
  pageType          AeoPageType
  confidence        Float
  difficulty        BountyDifficulty @default(EASY)
  estimatedReach    Int?
  /// estimatedReach × (conversionRate ?? default) × (avgOrderValue ?? company AOV)
  estimatedRevenue  Float?
  /// Site / funnel conversion (e.g. 0.025); defaults applied in app when null
  conversionRate    Float?
  /// Snapshot AOV used for revenue estimate (often from Shopify catalog median)
  avgOrderValue     Float?
  suggestedCluster  String?          @db.VarChar(255)
  status            BountyStatus     @default(OPEN)
  huntedAt          DateTime?        @db.Timestamptz(3)
  /// When generated content was published (e.g. AEO page go-live)
  publishedAt       DateTime?        @db.Timestamptz(3)
  aeoPageId         String?          @unique
  generationContext Json             @default("{}")
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  aeoPage           AeoPage?         @relation(fields: [aeoPageId], references: [id])
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([confidence])
  @@index([difficulty])
  @@index([companyId, status])
  @@index([companyId, status, confidence])
  @@map("citation_bounties")
}




