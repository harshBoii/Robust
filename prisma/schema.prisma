  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  adSet           MetaAdSet       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative        MetaCreative?   @relation(fields: [metaCreativeDbId], references: [id], onDelete: SetNull)
  preset          AdPreset?       @relation(fields: [presetId], references: [id], onDelete: SetNull)
  schedule        AdSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  duplicatedFrom  MetaAd?         @relation("MetaAdDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates      MetaAd[]        @relation("MetaAdDuplicate")
  publishJobs     AdPublishJob[]

  @@unique([metaIntegrationId, metaAdId])
  @@index([adSetId])
  @@index([metaIntegrationId])
  @@index([presetId])
  @@index([scheduleId])
  @@index([duplicatedFromId])
  @@map("meta_ads")
}

/// Polled every 6h from Meta Insights API — one row per ad per date preset
model MetaAdMetrics {
  id             String   @id @default(cuid())
  metaCampaignId String
  metaAdId       String   @db.VarChar(100)
  impressions    Int
  clicks         Int
  ctr            Float
  spend          Float
  cpc            Float?
  roas           Float?
  /// 3-second view rate — video ads only
  hookRate       Float?
  /// Computed: (today - publishedAt).days
  daysRunning    Int?
  /// FATIGUE | UNDERPERFORMER | WINNER — set by automation rule evaluator
  statusSignal   String?  @db.VarChar(64)
  actions        Json?
  /// "last_7d" | "last_30d" | "lifetime"
  datePreset     String   @db.VarChar(50)
  recordedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([metaCampaignId])
  @@index([metaAdId])
  @@index([metaAdId, datePreset])
  @@index([recordedAt(sort: Desc)])
  @@map("meta_ad_metrics")
}

// ================================================================
// PRESETS
// ================================================================

/// Ad-level creative preset: headline, landing URL, audience basics, pixel IDs
model AdPreset {
  id                String   @id @default(cuid())
  companyId         String
  name              String   @db.VarChar(120)
  isDefault         Boolean  @default(false)
  headline          String?  @db.VarChar(500)
  landingPageUrl    String?  @db.VarChar(2000)
  budgetOverride    Float?
  targetAgeMin      Int?
  targetAgeMax      Int?
  targetGenders     String[] @default([])
  targetProfessions String[] @default([])
  pixelIds          String[] @default([])
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metaAds MetaAd[]
  publishJobs AdPublishJob[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("ad_presets")
}

/// Adset-level preset: budget, bidding strategy, full Meta targeting object
model AdsetPreset {
  id             String    @id @default(cuid())
  companyId      String
  name           String    @db.VarChar(120)
  isDefault      Boolean   @default(false)
  dailyBudget    BigInt?
  lifetimeBudget BigInt?
  /// Legacy absolute schedule; prefer scheduleDuration + scheduleCustomEnd
  startTime      DateTime?
  endTime        DateTime?
  /// 3_days | 1_week | 1_month | custom — end is computed at ad set creation time
  scheduleDuration   String?   @db.VarChar(32)
  /// Required when scheduleDuration is custom
  scheduleCustomEnd  DateTime? @db.Timestamptz(3)
  billingEvent     String?  @db.VarChar(64)
  optimizationGoal String?  @db.VarChar(100)
  destinationType  String?  @db.VarChar(64)
  bidStrategy    String?   @db.VarChar(64)
  bidAmount      BigInt?
  isDefaultCreative Boolean @default(false)
  pacingType        String? @db.VarChar(32)
  promotedObject    Json?   @default("{}")
  attributionSpec   Json?   @default("[]")
  pinnedCampaignId  String?
  bidConstraints Json?     @default("{}")
  /// Full Meta targeting object stored as JSON — passed directly to API
  targeting      Json?     @default("{}")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pinnedCampaign MetaCampaign? @relation(fields: [pinnedCampaignId], references: [id], onDelete: SetNull)
  adSets  MetaAdSet[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@index([pinnedCampaignId])
  @@map("adset_presets")
}

/// Campaign-level preset: objective, spend cap, bid strategy, special ad categories
model CampaignPreset {
  id                  String   @id @default(cuid())
  companyId           String
  name                String   @db.VarChar(120)
  isDefault           Boolean  @default(false)
  objective           String?  @db.VarChar(64)
  status              String?  @db.VarChar(32)
  spendCap            BigInt?
  dailyBudget         BigInt?
  lifetimeBudget      BigInt?
  bidStrategy                  String?  @db.VarChar(64)
  specialAdCategories          Json?    @default("[]")
  /// Required by Meta when campaign has no daily/lifetime budget (ad-set budgets). null = CBO / not applicable.
  isAdsetBudgetSharingEnabled  Boolean?
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("campaign_presets")
}

// ================================================================
// META ADS AUTO MODE
// ================================================================

model MetaAdsAutoConfig {
  id                    String   @id @default(cuid())
  companyId             String   @unique @map("company_id")
  autoModeDefault       Boolean  @default(false) @map("auto_mode_default")
  allowNewCampaign      Boolean  @default(true) @map("allow_new_campaign")
